<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<Title>Open Traceability - GDST Extension</Title>
		<Description>Open source libraries for working with EPCIS in C# with extensions for GDST.</Description>
		<Copyright>MIT</Copyright>
		<PackageProjectUrl>https://github.com/ift-gftc/opentraceability</PackageProjectUrl>
		<PackageReadmeFile>GDST_README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/ift-gftc/opentraceability</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>epcis;open;traceability;ift;gdst</PackageTags>
	</PropertyGroup>
	
	<ItemGroup>
		<!-- Packed as the NuGet package readme (PackageReadmeFile). Deliberately not copied to build
		     output: CopyToOutputDirectory made it ride ProjectReferences into every consumer's bin/
		     and into the TestServer container image, where a packaging artefact has no business. -->
		<None Update="GDST_README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenTraceability\OpenTraceability.csproj" />
	</ItemGroup>

</Project>
